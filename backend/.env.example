# API Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Database Settings (Amazon RDS PostgreSQL)
DATABASE_URL=postgresql://examarena_admin:your_password@your-rds-endpoint.rds.amazonaws.com:5432/examarena

# Server Settings
PORT=8000

# AWS Configuration
AWS_REGION=ap-south-1
S3_BUCKET_NAME=exam-arena-assets

# Cognito Configuration
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_APP_CLIENT_ID=your_app_client_id
COGNITO_REGION=ap-south-1

# --- Rate Limiting ---
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_EXAM_GUEST_REQUESTS=10
RATE_LIMIT_EXAM_GUEST_WINDOW_SECONDS=3600
RATE_LIMIT_EXAM_USER_REQUESTS=50
RATE_LIMIT_EXAM_USER_WINDOW_SECONDS=3600
RATE_LIMIT_ADMIN_REQUESTS=30
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60